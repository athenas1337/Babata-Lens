# Babata Lens Environment Variables
# ⚠️ NEVER COMMIT THIS FILE WITH REAL KEYS! 
# Copy from .env.example and fill in your own values

# AI Providers
ANTHROPIC_API_KEY=your_anthropic_key_here
GOOGLE_AI_API_KEY=your_google_ai_key_here

# Market Data Providers
COINGECKO_API_KEY=your_coingecko_key_here
COINMARKETCAP_API_KEY=your_cmc_key_here

# Blockchain Data Providers
ETHERSCAN_API_KEY=your_etherscan_key_here
ALCHEMY_API_KEY=your_alchemy_key_here
SOLSCAN_API_KEY=your_solscan_key_here

# Analytics Providers
DUNE_API_KEY=your_dune_key_here

# Exchange Data Providers
BINGX_API_KEY=your_bingx_key_here

# Database & Cache
DATABASE_URL=your_database_url_here
UPSTASH_REDIS_REST_URL=your_upstash_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Authentication & Security
AUTH_SECRET=your_auth_secret_here
ADMIN_ACCESS_TOKEN=your_admin_token_here

# App Configuration
NEXT_PUBLIC_APP_NAME=Babata Lens Analytics
NODE_ENV=development
