# Babata Lens Environment Variables Example
# Copy to .env.local for local development or set in Vercel / Netlify dashboard

# AI Providers (at least one enables autonomous tool-calling analysis)
# Without a key the chat runs on the offline rule engine, which cannot call tools.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_AI_API_KEY=

# Market Data Providers (optional)
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

# Blockchain Data Providers
ETHERSCAN_API_KEY=
SOLSCAN_API_KEY=
ALCHEMY_API_KEY=

# Analytics
DUNE_API_KEY=

# Smart money (labelled-wallet tracking)
# Nansen has no free API tier; its Smart Money endpoints need a paid plan.
NANSEN_API_KEY=
# Free alternative: Moralis (deep-index) serves exact top-holder percentages.
# https://moralis.com  — free plan is enough for this dashboard.
MORALIS_API_KEY=

# Exchange Data
BINGX_API_KEY=
BINANCE_API_KEY=

# Database & Cache
# DATABASE_URL (Neon) keeps conversation history across serverless invocations.
# UPSTASH_REDIS_REST_URL/TOKEN share the provider cache across instances.
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Authentication & Security
# Required in production: the session cookie is signed with this value.
# openssl rand -hex 32
AUTH_SECRET=
# Optional. When set, browser session cookies are replaced by bearer-token auth.
ADMIN_ACCESS_TOKEN=

# App Configuration
NEXT_PUBLIC_APP_NAME=Babata Lens
DEV_ALLOW_ANONYMOUS=false
