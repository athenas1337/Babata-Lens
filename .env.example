# Babata Lens Environment Variables Example
# Copy to .env.local for local development or set in Vercel / Netlify dashboard

# AI Providers (At least one active key recommended)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Market Data Providers (optional)
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

# Blockchain Data Providers
ETHERSCAN_API_KEY=
SOLSCAN_API_KEY=
ALCHEMY_API_KEY=

# Analytics
DUNE_API_KEY=

# Exchange Data
BINGX_API_KEY=
BINANCE_API_KEY=

# Database & Cache (optional with SQLite fallback)
DATABASE_URL=
UPSTASH_REDIS_REST_TOKEN=

# Authentication & Security
AUTH_SECRET=your-secret-key-minimum-32-characters
ADMIN_ACCESS_TOKEN=your-admin-token

# App Configuration
NEXT_PUBLIC_APP_NAME=Babata Lens
NODE_ENV=development
DEV_ALLOW_ANONYMOUS=false
