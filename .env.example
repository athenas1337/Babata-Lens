# Babata Lens Environment Variables Example
# Copy to .env.local for local development or set in Vercel / Netlify dashboard

# AI Providers (At least one active key recommended; OpenRouter is pre-configured)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Market Data Providers
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

# Blockchain Data Providers
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
SOLSCAN_API_KEY=

# Analytics Providers
DUNE_API_KEY=

# Exchange Data (Binance Global Vision uses zero-credential public API; BingX optional)
BINGX_API_KEY=
BINGX_API_SECRET=

# Database & Cache
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Authentication & Security
AUTH_SECRET=
ADMIN_ACCESS_TOKEN=

# App Configuration
NEXT_PUBLIC_APP_NAME="Babata Lens"
NODE_ENV=development
